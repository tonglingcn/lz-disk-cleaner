#!/bin/sh
# postinst script for lz-disk-cleaner
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # Update icon cache
        if which gtk-update-icon-cache-3.0 >/dev/null 2>&1; then
            gtk-update-icon-cache-3.0 -q /usr/share/icons/hicolor 2>/dev/null || true
        fi
        if which gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
        fi
        
        # Update desktop database
        if which update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications 2>/dev/null || true
        fi
        
        # Ensure helper has correct permissions
        if [ -f /usr/bin/lz-disk-cleaner-helper ]; then
            chmod 755 /usr/bin/lz-disk-cleaner-helper
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
