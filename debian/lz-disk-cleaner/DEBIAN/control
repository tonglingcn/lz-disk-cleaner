Depends: libc6 (>= 2.34), libgcc-s1 (>= 3.0), libqt6core6 (>= 6.8.0), libqt6gui6 (>= 6.4.0), libqt6network6 (>= 6.2), libqt6svgwidgets6 (>= 6.8.0), libqt6widgets6 (>= 6.8.0), libstdc++6 (>= 5.2), libx11-6, polkitd | policykit-1, psmisc, lsof
